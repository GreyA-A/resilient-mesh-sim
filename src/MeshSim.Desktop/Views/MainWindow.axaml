<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeshSim.Desktop.ViewModels"
        xmlns:controls="using:MeshSim.Desktop.Controls"
        x:Class="MeshSim.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1500" Height="800"
        MinWidth="1100" MinHeight="560"
        Title="{Binding Title}">
	<DockPanel>

		<Border DockPanel.Dock="Bottom"
				Padding="10,6"
				BorderThickness="0,1,0,0"
				BorderBrush="#40808080">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="{Binding StatusText}" />
				<TextBlock Grid.Column="1" Text="{Binding Simulation.StateText}" FontWeight="SemiBold" />
			</Grid>
		</Border>

		<Border DockPanel.Dock="Top"
				Padding="10,8"
				BorderThickness="0,0,0,1"
				BorderBrush="#40808080"
				DataContext="{Binding Simulation}"
				x:DataType="vm:SimulationViewModel">
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Старт" Command="{Binding PlayCommand}" />
				<Button Content="Пауза" Command="{Binding PauseCommand}" />
				<Button Content="Крок" Command="{Binding StepCommand}" />
				<Button Content="Скинути" Command="{Binding ResetCommand}" />
				<TextBlock Text="Швидкість:" VerticalAlignment="Center" Margin="12,0,0,0" />
				<ComboBox ItemsSource="{Binding SpeedOptions}"
						  SelectedItem="{Binding SelectedSpeed}"
						  MinWidth="90">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="vm:SimulationSpeedOption">
							<TextBlock Text="{Binding Label}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
		</Border>

		<ScrollViewer DockPanel.Dock="Left"
					  Width="330"
					  HorizontalScrollBarVisibility="Disabled"
					  DataContext="{Binding Editor}"
					  x:DataType="vm:SceneEditorViewModel">
			<StackPanel Margin="12" Spacing="6">

				<TextBlock Text="Редактор сцени" FontSize="16" FontWeight="SemiBold" />
				<TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" />
				<TextBlock Text="Перетягуйте вузли й зони мишею. Будь-яка правка скидає прогін; під час виконання редагування вимкнено."
						   TextWrapping="Wrap" FontSize="11" Opacity="0.7" />

				<Border IsVisible="{Binding HasError}"
						Background="#33E74C3C"
						Padding="8"
						CornerRadius="4">
					<TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
				</Border>

				<StackPanel Spacing="6" IsEnabled="{Binding IsEditingEnabled}">

					<TextBlock Text="Вузол" FontWeight="SemiBold" Margin="0,10,0,0" />
					<TextBox Text="{Binding NodeId}" Watermark="Id вузла" />
					<Grid ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Text="{Binding NodeX}" Watermark="X, м" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding NodeY}" Watermark="Y, м" Margin="3,0,0,0" />
					</Grid>
					<Grid ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Text="{Binding NodeRange}" Watermark="Радіус, м" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding NodeBattery}" Watermark="Заряд, %" Margin="3,0,0,0" />
					</Grid>
					<Button Content="Додати вузол" Command="{Binding AddNodeCommand}" />
					<Button Content="Видалити вибраний вузол" Command="{Binding RemoveNodeCommand}" />

					<TextBlock Text="Зона завад" FontWeight="SemiBold" Margin="0,10,0,0" />
					<TextBox Text="{Binding ZoneId}" Watermark="Id зони" />
					<Grid ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Text="{Binding ZoneX}" Watermark="X, м" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding ZoneY}" Watermark="Y, м" Margin="3,0,0,0" />
					</Grid>
					<Grid ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Text="{Binding ZoneRadius}" Watermark="Радіус, м" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding ZoneIntensity}" Watermark="Інтенсивність 0..1" Margin="3,0,0,0" />
					</Grid>
					<Button Content="Додати зону" Command="{Binding AddZoneCommand}" />
					<Button Content="Перемкнути активність вибраної зони" Command="{Binding ToggleZoneCommand}" />
					<Button Content="Видалити вибрану зону" Command="{Binding RemoveZoneCommand}" />

					<TextBlock Text="Пакет" FontWeight="SemiBold" Margin="0,10,0,0" />
					<TextBox Text="{Binding PacketId}" Watermark="Id пакета" />
					<Grid ColumnDefinitions="*,*">
						<TextBox Grid.Column="0" Text="{Binding PacketSource}" Watermark="Відправник" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding PacketDestination}" Watermark="Отримувач" Margin="3,0,0,0" />
					</Grid>
					<Grid ColumnDefinitions="*,*,*">
						<TextBox Grid.Column="0" Text="{Binding PacketTtl}" Watermark="TTL" Margin="0,0,3,0" />
						<TextBox Grid.Column="1" Text="{Binding PacketPayloadBytes}" Watermark="Байт" Margin="3,0,3,0" />
						<TextBox Grid.Column="2" Text="{Binding PacketScheduledTimeMs}" Watermark="t, мс" Margin="3,0,0,0" />
					</Grid>
					<Button Content="Додати пакет" Command="{Binding AddPacketCommand}" />

					<TextBlock Text="Заплановані пакети" FontWeight="SemiBold" Margin="0,10,0,0" />
					<ListBox ItemsSource="{Binding Packets}"
							 SelectedItem="{Binding SelectedPacket}"
							 MaxHeight="160">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:PacketRow">
								<TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<Button Content="Видалити вибраний пакет" Command="{Binding RemovePacketCommand}" />

				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<Border DockPanel.Dock="Right"
				Width="380"
				Padding="12"
				BorderThickness="1,0,0,0"
				BorderBrush="#40808080"
				DataContext="{Binding Simulation}"
				x:DataType="vm:SimulationViewModel">
			<DockPanel>

				<StackPanel DockPanel.Dock="Top"
							Spacing="2"
							DataContext="{Binding Metrics}"
							x:DataType="vm:MetricsViewModel">
					<TextBlock Text="Метрики" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
					<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="Віртуальний час" Margin="0,2" />
						<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentTimeText}" Margin="0,2" />
						<TextBlock Grid.Row="1" Grid.Column="0" Text="Надіслано пакетів" Margin="0,2" />
						<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalPacketsSent}" Margin="0,2" />
						<TextBlock Grid.Row="2" Grid.Column="0" Text="Доставлено" Margin="0,2" />
						<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalPacketsDelivered}" Margin="0,2" />
						<TextBlock Grid.Row="3" Grid.Column="0" Text="Втрачено" Margin="0,2" />
						<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalPacketsDropped}" Margin="0,2" />
						<TextBlock Grid.Row="4" Grid.Column="0" Text="PDR (частка доставлених)" Margin="0,2" />
						<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PacketDeliveryRatioText}" Margin="0,2" />
						<TextBlock Grid.Row="5" Grid.Column="0" Text="Середня кількість стрибків" Margin="0,2" />
						<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AverageHopCountText}" Margin="0,2" />
					</Grid>

					<TextBlock Text="Втрати за причинами" FontWeight="SemiBold" Margin="0,10,0,2" />
					<ItemsControl ItemsSource="{Binding DropsByReason}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:DropReasonRow">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock Grid.Column="0" Text="{Binding Description}" />
									<TextBlock Grid.Column="1" Text="{Binding Count}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<TextBlock DockPanel.Dock="Top"
						   Text="Журнал подій (нові зверху)"
						   FontWeight="SemiBold"
						   Margin="0,14,0,4" />
				<ListBox ItemsSource="{Binding EventLog}">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="x:String">
							<TextBlock Text="{Binding .}" TextWrapping="Wrap" FontSize="12" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

			</DockPanel>
		</Border>

		<controls:MapControl Map="{Binding Map}" Editor="{Binding Editor}" />

	</DockPanel>
</Window>